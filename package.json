{
  "name": "liveplace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web",
    "check": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run --passWithNoTests",
    "gate": "node .agent/core/gate.mjs",
    "calibrate": "node .agent/core/calibrate.mjs",
    "convex:deploy": "pnpm --filter @liveplace/durable exec convex deploy"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/node": "^26.5.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
